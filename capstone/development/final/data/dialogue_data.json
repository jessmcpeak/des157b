    "whatIsCM": {
        "visited": false,
        "dialogue": [
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Class membership is the idea that an entity qualifies for moral standing if it belongs to a class whose members typically possess a morally relevant capacity (e.g., membership in a cognitively sophisticated species like humans)."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "This is sometimes used to justify granting moral standing to entities within that class (like permanently unconscious humans) who individually lack the capacity."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "However, its relevance for moral standing is debated, as the capacity itself is arguably the morally relevant factor, not mere class membership."
            }
        ],
