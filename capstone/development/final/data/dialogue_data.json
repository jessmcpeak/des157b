    "whatIsInt": {
        "visited": false,
        "dialogue": [
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Intelligence is often discussed, particularly regarding reaching human-like or superintelligence levels."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Human-level intelligence might be considered a sufficient condition by some."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "However, intelligence itself is hard to define and measure for AIs, and the moral relevance might stem more from associated capacities like sentience rather than intelligence per se."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Would you like to discuss another cognitive capability?"
            }
        ],
        "choice": [
            {
                "type": "spoken",
                "text": "What is rationality?",
                "nextScene": "whatIsRat"
            },
            {
                "type": "spoken",
                "text": "What is autonomy?",
                "nextScene": "whatIsAuto"
            },
            {
                "type": "spoken",
                "text": "What is agency?",
                "nextScene": "whatIsAg"
            },
            {
                "type": "spoken",
                "text": "Actually, let's talk about something else.",
                "nextScene": "whatIsMoralStand"
            }
        ]
    },
