    "whatIsPer": {
        "visited": false,
        "dialogue": [
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Both moral and legal personhood are frequently proposed as criteria for entitlement to rights, including human rights."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "The concept of personhood is debated and is increasingly seen as not solely tied to being human but to meeting certain criteria, often related to cognitive abilities, consciousness, or self-awareness."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Legal personhood might also be granted for instrumental reasons, as with corporations."
            }
        ],
        "choice": [
            {
                "type": "",
                "text": "",
                "nextScene": ""
            }
        ]
    },
