    "whatIsAuto": {
        "visited": false,
        "dialogue": [
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Autonomy is the capacity for independence and determining one's own goals and actions is discussed."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Some see autonomy as a measure of genuine desires grounding moral status."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "It is debated whether autonomy is a necessary condition for moral patiency."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Autonomy is also linked to free will and self-direction, relevant to discussions of AI rights."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Would you like to discuss another cognitive capability?"
            }
        ],
        "choice": [
            {
                "type": "spoken",
                "text": "What is intelligence?",
                "nextScene": "whatIsInt"
            },
            {
                "type": "spoken",
                "text": "What is rationality?",
                "nextScene": "whatIsRat"
            },
            {
                "type": "spoken",
                "text": "What is agency?",
