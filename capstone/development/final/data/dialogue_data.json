    "whatIsSen": {
        "visited": false,
        "dialogue": [
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Sentience is defined as the capacity for positive or negative experiences, such as feelings, physical sensations, emotional states, and moods, including pleasure and pain."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Sentience is widely considered a sufficient criterion for moral standing."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "The intuitive appeal is that sentient entities have an interest in avoiding pain, which seems intrinsically important."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Some sources debate whether sentience is also a necessary condition for moral standing."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "There are significant challenges in establishing whether an AI is truly sentient."
            },
            {
                "charID": "aida",
                "type": "spoken",
                "charName": "aida",
                "text": "Would you like to discuss another psychological capacity?"
            }
        ],
        "choice": [
            {
                "type": "spoken",
                "text": "What is consciousness?",
                "nextScene": "whatIsCon"
